{
	"version": 3,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"BUILD_TESTS": "OFF",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "mac_base",
			"hidden": true,
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm@17/bin/clang++",
				"CMAKE_OSX_SYSROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk",
				"CMAKE_EXE_LINKER_FLAGS": "-Wl,-syslibroot,/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk",
				"CMAKE_PREFIX_PATH": "/opt/homebrew/Cellar/boost/1.92.0"
			}
		},
		{
			"name": "debug",
			"displayName": "Debug",
			"description": "Debug configuration",
			"inherits": "mac_base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"ENABLE_CLANG_TIDY": "ON",
				"ENABLE_CLANG_FORMAT_CHECK": "ON"
			}
		},
		{
			"name": "release",
			"displayName": "Release",
			"description": "Release configuration",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	]
}
